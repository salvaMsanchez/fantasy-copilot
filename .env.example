# Copia este fichero a .env y rellena las claves. El fichero .env no se sube al repositorio.

# Obligatoria al usar OpenAI
OPENAI_API_KEY=

# Obligatoria al buscar vídeos
YOUTUBE_API_KEY=

# Proxy opcional para descargar transcripciones: se definen las dos o ninguna
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=

# Opcionales, con su valor por defecto
FANTASY_DATOS_DIR=datos
FANTASY_MODELO_EXTRACCION=gpt-5.4-nano
FANTASY_MODELO_NORMALIZACION=gpt-5.4-nano
FANTASY_MODELO_AGENTE=gpt-5.4-mini
FANTASY_MODELO_EMBEDDINGS=text-embedding-3-small
